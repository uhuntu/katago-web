# Third-party KataGo source clone (not our code; see README for setup)
src/

# Neural net weights (large binary; see README for download link)
models/

# Python virtualenvs (regenerate via requirements.txt)
webui-venv/
katrain-venv/

# Runtime logs
*.log
gtp_logs/

# Python cache
__pycache__/
*.pyc

# Web board HTTP basic auth credentials
.auth

# Conversation transcripts / notes (may contain secrets discussed in chat)
notes/

# Local agent/session state (plans, caches)
.stepcode/
